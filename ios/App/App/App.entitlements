<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- APNs environment. Xcode's build system flips this to
	     "production" automatically in App Store / TestFlight archives;
	     "development" here covers local device runs. -->
	<key>aps-environment</key>
	<string>development</string>
</dict>
</plist>
