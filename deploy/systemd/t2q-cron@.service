[Unit]
Description=Tradies2Quote scheduled job (%i)
After=network-online.target t2q.service
Requires=t2q.service

[Service]
Type=oneshot
User=deploy
Group=deploy
WorkingDirectory=/srv/t2q/app
EnvironmentFile=/srv/t2q/app.env
ExecStart=/usr/bin/node /srv/t2q/app/deploy/run-cron.mjs %i
TimeoutStartSec=30min
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
