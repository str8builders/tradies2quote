# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/quote-eval-report.txt

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.gstack/

# local tooling / OS artifacts (not project source)
.agents/
.metadata_never_index

# Generated from the pinned PDF.js package before dev/build
/public/t2qcal/vendor/pdfjs/

# Barcode scanner's ZXing .wasm, copied from node_modules before dev/build
/public/vendor/zxing/

# Marketing video renders for sharing (scripts/render-marketing.mjs); not served by the site
/marketing-media/
