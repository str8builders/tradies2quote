<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CAPACITOR_DEBUG</key>
	<string>$(CAPACITOR_DEBUG)</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
        <string>Tradies2Quote</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>NSMicrophoneUsageDescription</key>
	<string>Record your voice to describe a job — Tradies2Quote turns it into a quote draft.</string>
	<key>NSCameraUsageDescription</key>
	<string>Scan plans, site drawings and materials to add them to a quote.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Attach existing plan photos and site pictures to your quotes.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>When you start or finish work, Tradies2Quote pins where you are (for example "At the Hemi Walker job") on your timesheet, and checks the weather at your site.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>Only if you turn it on in the Timesheet: while you're clocked in, Tradies2Quote keeps your route to work out travel kilometres and show your boss where the team is; and with automatic clock-in, it starts and stops your hours when you arrive at and leave a job, in your work hours only.</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>location</string>
	</array>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<!-- Portrait-only on iPhone: the product is a phone-first form UI;
	     landscape WKWebView reflow is untested surface a reviewer can
	     rotate into. iPhone-only target (device family 1) — no ~ipad keys. -->
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>
</dict>
</plist>
