<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CAPACITOR_DEBUG</key>
	<string>$(CAPACITOR_DEBUG)</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
        <string>Tradies2Quote</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>NSMicrophoneUsageDescription</key>
	<string>Record your voice to describe a job — Tradies2Quote turns it into a quote draft.</string>
	<key>NSCameraUsageDescription</key>
	<string>Scan plans, site drawings, supplier quotes and price lists to add them to your quotes and prices.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Attach plan photos, site pictures, supplier quotes and price lists to your quotes and prices.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>When you start or finish work, Tradies2Quote pins where you are (for example "At the Hemi Walker job") on your timesheet and works out your travel kilometres while you're clocked in. It also shows the weather where you are.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>Only if you turn on automatic clock-in in the Timesheet: Tradies2Quote starts and stops your hours when you arrive at and leave a job, during your work hours, even with the app closed, and keeps rough travel kilometres while you're clocked in. If you work for a business on Tradies2Quote, its owner sees your hours and where you clocked in.</string>
	<key>NSCalendarsUsageDescription</key>
	<string>So you can add a booked job to your calendar. Tradies2Quote only adds the job you choose, and never reads your calendar.</string>
	<key>NSSupportsLiveActivities</key>
	<true/>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>com.str8builders.tradies2quote</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>t2q</string>
			</array>
		</dict>
	</array>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIApplicationShortcutItems</key>
	<array>
		<dict>
			<key>UIApplicationShortcutItemIconType</key>
			<string>UIApplicationShortcutIconTypeCompose</string>
			<key>UIApplicationShortcutItemTitle</key>
			<string>New quote</string>
			<key>UIApplicationShortcutItemType</key>
			<string>com.str8builders.tradies2quote.new-quote</string>
		</dict>
		<dict>
			<key>UIApplicationShortcutItemIconType</key>
			<string>UIApplicationShortcutIconTypeTime</string>
			<key>UIApplicationShortcutItemTitle</key>
			<string>Timesheet</string>
			<key>UIApplicationShortcutItemType</key>
			<string>com.str8builders.tradies2quote.timesheet</string>
		</dict>
		<dict>
			<key>UIApplicationShortcutItemIconType</key>
			<string>UIApplicationShortcutIconTypeTask</string>
			<key>UIApplicationShortcutItemTitle</key>
			<string>Jobs</string>
			<key>UIApplicationShortcutItemType</key>
			<string>com.str8builders.tradies2quote.jobs</string>
		</dict>
		<dict>
			<key>UIApplicationShortcutItemIconType</key>
			<string>UIApplicationShortcutIconTypeCapturePhoto</string>
			<key>UIApplicationShortcutItemTitle</key>
			<string>Scan a supplier quote</string>
			<key>UIApplicationShortcutItemType</key>
			<string>com.str8builders.tradies2quote.supplier-quote</string>
		</dict>
	</array>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<!-- Portrait-only on iPhone: the product is a phone-first form UI;
	     landscape WKWebView reflow is untested surface a reviewer can
	     rotate into. iPhone-only target (device family 1) — no ~ipad keys. -->
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>
</dict>
</plist>
